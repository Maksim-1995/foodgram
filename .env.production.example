# Пример .env.production файла для продакшена
# Скопируйте этот файл как .env и замените значения на реальные!

# База данных
POSTGRES_USER=django_users
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=django

# БД хост и порт (для Docker сети)
DB_HOST=db
DB_PORT=5432

# Django секретный ключ - замените на случайный!
# Генерировать можно: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-random-secret-key-here

# DEBUG должен быть False в продакшене!
DEBUG=False

# Разрешенные хосты - замените на ваш домен/IP
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1

# Базовый URL для коротких ссылок на рецепты
# Укажите ваш домен или IP-адрес, например: http://158.160.253.0
SHORT_LINK_BASE_URL=http://your-domain.com

# Docker username для продакшен образов
DOCKER_USERNAME=your-dockerhub-username